# Required for answer generation (never commit the real key).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage paths (relative to project root or container /app)
DOCUMENTS_DIR=documents
DATA_DIR=data
DATABASE_URL=sqlite:///data/rag_platform.db
SQLITE_PATH=data/rag_platform.db
VECTOR_STORE_PATH=data/vector_store.pkl
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=enterprise_rag_documents
AUTO_MIGRATE_LEGACY_VECTORS=true

# Ingestion and retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=100
TOP_K=3
RETRIEVAL_SCORE_FLOOR=0.0
LOG_LEVEL=INFO

# Optional workflow orchestration (classic path when WORKFLOW_ENABLED=false)
WORKFLOW_ENABLED=false
WORKFLOW_FALLBACK_ENABLED=true
WORKFLOW_OBSERVABILITY_ENABLED=true
WORKFLOW_EVALUATION_ENABLED=true

# Optional MLflow tracking (requires: pip install -e ".[mlflow]" or mlflow extra)
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=pdf_based_rag
